{
	"name": "super-kernel/composer",
	"description": "Composer package metadata and cached class graphs for SuperKernel.",
	"type": "library",
	"license": "MIT",
	"abandoned": true,
	"require": {
		"php": ">=8.4.27 <8.5",
		"super-kernel/attribute": "self.version",
		"super-kernel/contract": "self.version",
		"super-kernel/scan-isolation": "self.version",
		"super-kernel/tokenizer": "self.version"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95.27",
		"phpunit/phpunit": "^13.4.5"
	},
	"autoload": {
		"psr-4": {
			"SuperKernel\\Composer\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SuperKernel\\Composer\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
		"format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
		"test": "@php vendor/bin/phpunit"
	}
}
